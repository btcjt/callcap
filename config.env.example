# callcap configuration. Copied to ~/.config/callcap/config.env on first build
# and never overwritten. Every value is optional; uncomment to override.

# Where recordings and transcripts are written.
#CALLCAP_DIR="$HOME/Documents/call-recordings"

# How your own channel is labelled in transcripts.
# Defaults to the first word of your account's full name.
#CALLCAP_ME="Me"

# Default input device, by name (substring match). Empty = system default.
# Naming a wired mic keeps Bluetooth headphones out of low-quality headset mode.
#CALLCAP_MIC="USB audio"

# Default app to capture, by name or bundle id. Empty = all system audio,
# which works without knowing which app owns the call.
#CALLCAP_APP="Signal"

# Auto-stop, in minutes. 0 disables.
#CALLCAP_SILENCE_TIMEOUT=5
#CALLCAP_MAX_DURATION=180

# Transcription.
#CALLCAP_MODEL="$HOME/.cache/whisper-cpp/ggml-large-v3.bin"
#CALLCAP_LANGUAGE=en
#CALLCAP_THREADS=8
